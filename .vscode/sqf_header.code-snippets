"Basic file header for RAA project": {
  "prefix": "header",
  "body": [
    "#include \"../script_component.hpp\"",
    "/* File: ${2:filename}.sqf",
    "* Author(s): riksuFIN",
    "* Description:	${3:description}",
    "*",
    "* Called from:	",
    "* Local to:		",
    "* Parameter(s):	",
    "* 0:	",
    "* 1:	",
    "* 2:	",
    "*",
    "Returns: 	",
    "*",
    "* Example:	",
    "*	[] call RAA_${1:module}_${2:filename}",
    "*/"
  ],
  "description": "Basic file header for RAA project"
}


"Debug": {
  "prefix": "debug",
  "body": [
    "[COMPNAME, GVAR(debug), \"${1:priority. Options: ERROR, WARNING, LOG, INFO, NOTE, BROADCAST}\", ${2:message string}] call EFUNC(common,debugNew);"
  ],
  "description": "Debug"
}

